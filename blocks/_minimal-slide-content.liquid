{% doc %}
  Renders the nested text and button content for an image slide.
{% enddoc %}

<div class="minimal-slide__content" {{ block.shopify_attributes }}>
  <div class="minimal-slide__content-inner">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Slide content",
  "tag": null,
  "blocks": [{ "type": "text" }, { "type": "button" }],
  "presets": [{
    "name": "Slide content",
    "blocks": {
      "eyebrow": { "type": "text", "name": "Text – New Campaign", "settings": { "text": "<p>NEW CAMPAIGN</p>" } },
      "heading": { "type": "text", "name": "Text – Softness in Comfort", "settings": { "text": "<h2>Softness in Comfort</h2>" } },
      "button": { "type": "button", "settings": { "label": "Shop Collection", "link": "shopify://collections/all" } }
    },
    "block_order": ["eyebrow", "heading", "button"]
  }]
}
{% endschema %}

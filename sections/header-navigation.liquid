        <div class="storefront-navigation__mobile-drawer-footer">
          <a class="storefront-navigation__mobile-login" href="{{ routes.account_url }}">{{ 'navigation.login' | t }}</a>
          <div class="storefront-navigation__mobile-localization-row">
            {% if localization.available_countries.size > 1 %}
              <details class="storefront-navigation__mobile-localization">
                <summary>
                  <span class="storefront-navigation__currency-flag" aria-hidden="true">★</span>
                  <span>{{ navigation_currency_code }} {{ localization.country.currency.symbol }}</span>
                  <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
                </summary>
                <div class="storefront-navigation__mobile-localization-popover">
                  {% form 'localization', id: mobile_localization_form_id %}
                    <input type="hidden" name="return_to" value="{{ request.path }}">
                    {% for country in localization.available_countries %}
                      <button type="submit" name="country_code" value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} aria-current="true"{% endif %}>{{ country.name | escape }} · {{ country.currency.iso_code }}</button>
                    {% endfor %}
                  {% endform %}
                </div>
              </details>
            {% else %}
              <span class="storefront-navigation__mobile-localization-static">
                <span class="storefront-navigation__currency-flag" aria-hidden="true">★</span>
                <span>{{ navigation_currency_code }} {{ localization.country.currency.symbol }}</span>
                <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
              </span>
            {% endif %}

            {% if localization.available_languages.size > 1 %}
              <details class="storefront-navigation__mobile-localization storefront-navigation__mobile-language">
                <summary>
                  <span>{{ request.locale.name }}</span>
                  <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
                </summary>
                <div class="storefront-navigation__mobile-localization-popover">
                  {% form 'localization', id: mobile_language_form_id %}
                    <input type="hidden" name="return_to" value="{{ request.path }}">
                    {% for language in localization.available_languages %}
                      <button type="submit" name="language_code" value="{{ language.iso_code }}"{% if language.iso_code == request.locale.iso_code %} aria-current="true"{% endif %}>{{ language.endonym_name | escape }}</button>
                    {% endfor %}
                  {% endform %}
                </div>
              </details>
            {% else %}
              <span class="storefront-navigation__mobile-localization-static storefront-navigation__mobile-language-static">
                <span>{{ request.locale.name | default: 'English' }}</span>
                <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
              </span>
            {% endif %}
          </div>


    text-decoration: none;
  }

  .storefront-navigation__child-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 13px;
  }

  .storefront-navigation__child-link {
    position: relative;
    display: inline-flex;
    color: #131313;
    font-family: Figtree, sans-serif;
    font-size: 16px;
    font-weight: 400;
    line-height: 25.6px;

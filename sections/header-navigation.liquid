{% liquid
  assign all_products_url = routes.all_products_collection_url
  assign women_url = all_products_url
  assign men_url = all_products_url
  assign women_sale_url = all_products_url
  assign women_favorites_url = all_products_url
  assign about_us_url = routes.root_url
  assign contact_url = routes.root_url
  assign faqs_url = routes.root_url
  assign store_locations_url = routes.root_url
  assign recently_viewed_url = routes.root_url
  assign journal_url = routes.root_url
  assign women_sale_title = 'navigation.womens_sale' | t
  assign women_favorites_title = 'navigation.womens_favorites' | t
  assign men_best_deals_collection = section.settings.men_best_deals_collection
  assign navigation_currency_code = localization.country.currency.iso_code | default: shop.currency
  assign navigation_localization_form_id = 'NavigationLocalizationForm-' | append: section.id

  if section.settings.women_collection != blank
    assign women_url = section.settings.women_collection.url
  endif

  if section.settings.men_collection != blank
    assign men_url = section.settings.men_collection.url
  endif

  if men_best_deals_collection == blank
    assign men_best_deals_collection = section.settings.men_collection
  endif

  if men_best_deals_collection == blank
    assign men_best_deals_collection = collections['all']
  endif

  if section.settings.women_sale_link != blank
    assign women_sale_url = section.settings.women_sale_link
  endif

  if section.settings.women_favorites_link != blank
    assign women_favorites_url = section.settings.women_favorites_link
  endif

  if pages['about-us'] != blank
    assign about_us_url = pages['about-us'].url
  endif

  if pages['contact'] != blank
    assign contact_url = pages['contact'].url
  endif

  if pages['faqs'] != blank
    assign faqs_url = pages['faqs'].url
  endif

  if pages['store-locations'] != blank
    assign store_locations_url = pages['store-locations'].url
  endif

  if pages['recently-viewed'] != blank
    assign recently_viewed_url = pages['recently-viewed'].url
  endif

  if blogs['news'] != blank
    assign journal_url = blogs['news'].url
  endif
%}

<header class="storefront-navigation{% if request.page_type == 'index' %} storefront-navigation--homepage{% endif %}" data-storefront-navigation>
  <nav class="storefront-navigation__bar" aria-label="{{ 'navigation.primary' | t }}">
    <ul class="storefront-navigation__list">
      <li class="storefront-navigation__item storefront-navigation__item--mega" data-navigation-item>
        <a id="NavigationWomenLabel-{{ section.id }}" class="storefront-navigation__collection-link" href="{{ women_url }}" data-navigation-collection-link>{{ 'navigation.women' | t }}</a>
        <button id="NavigationWomenToggle-{{ section.id }}" class="storefront-navigation__toggle" type="button" aria-expanded="false" aria-controls="NavigationWomenMenu-{{ section.id }}" aria-label="{{ 'navigation.open_womens_menu' | t }}" data-open-label="{{ 'navigation.open_womens_menu' | t }}" data-close-label="{{ 'navigation.close_womens_menu' | t }}" data-navigation-toggle>
          <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
        </button>
        <div id="NavigationWomenMenu-{{ section.id }}" class="storefront-navigation__panel storefront-navigation__panel--mega" role="region" aria-labelledby="NavigationWomenLabel-{{ section.id }}" aria-hidden="true" inert data-navigation-panel>
          <div class="storefront-navigation__mega-surface">
            <div class="storefront-navigation__mega-grid storefront-navigation__mega-grid--women">
              {% if section.settings.women_menu != blank %}
                <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 200ms">
                  <ul class="storefront-navigation__editorial-list">
                    {% for link in section.settings.women_menu.links %}
                      {% if link.links == blank %}
                        <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                      {% endif %}
                    {% endfor %}
                  </ul>
                </div>

                {% assign women_group_delay = 250 %}
                {% for link in section.settings.women_menu.links %}
                  {% if link.links != blank %}
                    <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: {{ women_group_delay }}ms">
                      <a class="storefront-navigation__group-label" href="{{ link.url }}">{{ link.title | escape }}</a>
                      <ul class="storefront-navigation__child-list">
                        {% for child_link in link.links %}
                          <li><a class="storefront-navigation__child-link" href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                        {% endfor %}
                      </ul>
                    </div>
                    {% assign women_group_delay = women_group_delay | plus: 50 %}
                  {% endif %}
                {% endfor %}
              {% else %}
              <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 200ms">
                <ul class="storefront-navigation__editorial-list">
                  <li><a href="{{ women_url }}" data-navigation-first-link>{{ 'navigation.top_picks' | t }}</a></li>
                  <li><a href="{{ women_url }}">{{ 'navigation.best_sellers' | t }}</a></li>
                  <li><a href="{{ women_url }}">{{ 'navigation.trending' | t }}</a></li>
                  <li><a href="{{ women_url }}">{{ 'navigation.new_arrivals' | t }}</a></li>
                  <li><a href="{{ women_url }}">{{ 'navigation.on_sale' | t }}</a></li>
                </ul>
              </div>
              <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 250ms">
                <p class="storefront-navigation__group-label">{{ 'navigation.by_activity' | t }}</p>
                <ul class="storefront-navigation__child-list">
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.hiking' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.running' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.training' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.tennis' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.lifestyle' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.shop_all' | t }}</a></li>
                </ul>
              </div>
              <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 300ms">
                <p class="storefront-navigation__group-label">{{ 'navigation.by_feature' | t }}</p>
                <ul class="storefront-navigation__child-list">
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.cushioned' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.waterproof' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.water_resistant' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.breathable' | t }}</a></li>
                  <li><a class="storefront-navigation__child-link" href="{{ women_url }}">{{ 'navigation.windproof' | t }}</a></li>
                </ul>
              </div>
              {% endif %}
              <div class="storefront-navigation__promo-area">
                <a class="storefront-navigation__promo-card storefront-navigation__menu-reveal" href="{{ women_sale_url }}" style="--menu-reveal-delay: 350ms">
                  <span class="storefront-navigation__promo-media">
                    {% if section.settings.women_sale_image != blank %}
                      {{ section.settings.women_sale_image | image_url: width: 900 | image_tag: class: 'storefront-navigation__promo-image', loading: 'lazy', alt: women_sale_title }}
                    {% else %}
                      {{ 'women-sale-meadow.png' | asset_url | image_tag: class: 'storefront-navigation__promo-image', loading: 'lazy', alt: women_sale_title }}
                    {% endif %}
                  </span>
                  <span class="storefront-navigation__promo-copy">
                    <strong>{{ women_sale_title }}</strong>
                    <span>{{ 'navigation.shop_now' | t }} <span aria-hidden="true">↗</span></span>
                  </span>
                </a>
                <a class="storefront-navigation__promo-card storefront-navigation__menu-reveal" href="{{ women_favorites_url }}" style="--menu-reveal-delay: 400ms">
                  <span class="storefront-navigation__promo-media">
                    {% if section.settings.women_favorites_image != blank %}
                      {{ section.settings.women_favorites_image | image_url: width: 900 | image_tag: class: 'storefront-navigation__promo-image', loading: 'lazy', alt: women_favorites_title }}
                    {% else %}
                      {{ 'women-favorites-court.png' | asset_url | image_tag: class: 'storefront-navigation__promo-image', loading: 'lazy', alt: women_favorites_title }}
                    {% endif %}
                  </span>
                  <span class="storefront-navigation__promo-copy">
                    <strong>{{ women_favorites_title }}</strong>
                    <span>{{ 'navigation.shop_now' | t }} <span aria-hidden="true">↗</span></span>
                  </span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </li>

      <li class="storefront-navigation__item storefront-navigation__item--mega" data-navigation-item>
        <a id="NavigationMenLabel-{{ section.id }}" class="storefront-navigation__collection-link" href="{{ men_url }}" data-navigation-collection-link>{{ 'navigation.men' | t }}</a>
        <button id="NavigationMenToggle-{{ section.id }}" class="storefront-navigation__toggle" type="button" aria-expanded="false" aria-controls="NavigationMenMenu-{{ section.id }}" aria-label="{{ 'navigation.open_mens_menu' | t }}" data-open-label="{{ 'navigation.open_mens_menu' | t }}" data-close-label="{{ 'navigation.close_mens_menu' | t }}" data-navigation-toggle>
          <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
        </button>
        <div id="NavigationMenMenu-{{ section.id }}" class="storefront-navigation__panel storefront-navigation__panel--mega" role="region" aria-labelledby="NavigationMenLabel-{{ section.id }}" aria-hidden="true" inert data-navigation-panel>
          <div class="storefront-navigation__mega-surface">
            <div class="storefront-navigation__mega-grid storefront-navigation__mega-grid--men">
              <div class="storefront-navigation__menu-columns">
                {% if section.settings.men_menu != blank %}
                  <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 200ms">
                    <ul class="storefront-navigation__editorial-list">
                      {% for link in section.settings.men_menu.links %}
                        {% if link.links == blank %}
                          <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                        {% endif %}
                      {% endfor %}
                    </ul>
                  </div>

                  {% assign men_group_delay = 250 %}
                  {% for link in section.settings.men_menu.links %}
                    {% if link.links != blank %}
                      <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: {{ men_group_delay }}ms">
                        <a class="storefront-navigation__group-label" href="{{ link.url }}">{{ link.title | escape }}</a>
                        <ul class="storefront-navigation__child-list">
                          {% for child_link in link.links %}
                            <li><a class="storefront-navigation__child-link" href="{{ child_link.url }}">{{ child_link.title | escape }}</a></li>
                          {% endfor %}
                        </ul>
                      </div>
                      {% assign men_group_delay = men_group_delay | plus: 50 %}
                    {% endif %}
                  {% endfor %}
                {% else %}
                <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 200ms">
                  <ul class="storefront-navigation__editorial-list">
                    <li><a href="{{ men_url }}" data-navigation-first-link>{{ 'navigation.top_picks' | t }}</a></li>
                    <li><a href="{{ men_url }}">{{ 'navigation.best_sellers' | t }}</a></li>
                    <li><a href="{{ men_url }}">{{ 'navigation.trending' | t }}</a></li>
                    <li><a href="{{ men_url }}">{{ 'navigation.new_arrivals' | t }}</a></li>
                    <li><a href="{{ men_url }}">{{ 'navigation.on_sale' | t }}</a></li>
                  </ul>
                </div>
                <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 250ms">
                  <p class="storefront-navigation__group-label">{{ 'navigation.by_activity' | t }}</p>
                  <ul class="storefront-navigation__child-list">
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.hiking' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.running' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.training' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.tennis' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.lifestyle' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.shop_all' | t }}</a></li>
                  </ul>
                </div>
                <div class="storefront-navigation__mega-column storefront-navigation__menu-reveal" style="--menu-reveal-delay: 300ms">
                  <p class="storefront-navigation__group-label">{{ 'navigation.by_feature' | t }}</p>
                  <ul class="storefront-navigation__child-list">
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.cushioned' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.waterproof' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.water_resistant' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.breathable' | t }}</a></li>
                    <li><a class="storefront-navigation__child-link" href="{{ men_url }}">{{ 'navigation.windproof' | t }}</a></li>
                  </ul>
                </div>
                {% endif %}
              </div>
              <section class="storefront-navigation__men-deals" aria-labelledby="NavigationMenDealsTitle-{{ section.id }}">
                <div class="storefront-navigation__men-deals-header storefront-navigation__menu-reveal" style="--menu-reveal-delay: 350ms">
                  <h2 id="NavigationMenDealsTitle-{{ section.id }}">{{ 'navigation.best_deals' | t }} <span aria-hidden="true">&#128293;</span></h2>
                  <span class="storefront-navigation__men-deals-arrows" aria-hidden="true">
                    <svg viewBox="0 0 16 16" focusable="false"><path d="M10 3 5 8l5 5" /></svg>
                    <svg viewBox="0 0 16 16" focusable="false"><path d="m6 3 5 5-5 5" /></svg>
                  </span>
                </div>

                {% if men_best_deals_collection != blank and men_best_deals_collection.products_count > 0 %}
                  <div class="storefront-navigation__deal-products">
                    {% for product in men_best_deals_collection.products limit: 3 %}
                      {% liquid
                        assign compare_at_price = product.compare_at_price_max
                        assign is_on_sale = false

                        if compare_at_price > product.price
                          assign is_on_sale = true
                          assign saving = compare_at_price | minus: product.price
                          assign discount = saving | times: 100.0 | divided_by: compare_at_price | round
                        endif
                      %}
                      <article class="storefront-navigation__deal-card storefront-navigation__menu-reveal" style="--menu-reveal-delay: {{ forloop.index0 | times: 50 | plus: 400 }}ms">
                        <a class="storefront-navigation__deal-media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                          {% if is_on_sale %}
                            <span class="storefront-navigation__deal-badge">-{{ discount }}%</span>
                          {% endif %}
                          {% if product.featured_image != blank %}
                            {{ product.featured_image | image_url: width: 640 | image_tag: class: 'storefront-navigation__deal-image', loading: 'lazy', alt: product.title }}
                          {% else %}
                            {{ 'product-1' | placeholder_svg_tag: 'storefront-navigation__deal-placeholder' }}
                          {% endif %}
                        </a>
                        {% if product.images.size > 0 %}
                          <div class="storefront-navigation__deal-thumbnails" aria-hidden="true">
                            {% for image in product.images limit: 2 %}
                              <span class="storefront-navigation__deal-thumbnail">
                                {{ image | image_url: width: 96 | image_tag: loading: 'lazy', alt: '' }}
                              </span>
                            {% endfor %}
                          </div>
                        {% endif %}
                        <a class="storefront-navigation__deal-title" href="{{ product.url }}">{{ product.title | escape }}</a>
                        <div class="storefront-navigation__deal-prices">
                          <span class="storefront-navigation__deal-price{% if is_on_sale %} storefront-navigation__deal-price--sale{% endif %}">{{ product.price | money }}</span>
                          {% if is_on_sale %}
                            <s>{{ compare_at_price | money }}</s>
                          {% endif %}
                        </div>
                      </article>
                    {% endfor %}
                  </div>
                {% endif %}
              </section>
            </div>
          </div>
        </div>
      </li>

      <li class="storefront-navigation__item storefront-navigation__item--pages" data-navigation-item>
        <button id="NavigationPagesToggle-{{ section.id }}" class="storefront-navigation__pages-toggle" type="button" aria-expanded="false" aria-controls="NavigationPagesMenu-{{ section.id }}" aria-label="{{ 'navigation.open_pages_menu' | t }}" data-open-label="{{ 'navigation.open_pages_menu' | t }}" data-close-label="{{ 'navigation.close_pages_menu' | t }}" data-navigation-toggle>
          <span>{{ 'navigation.pages' | t }}</span>
          <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
        </button>
        <div id="NavigationPagesMenu-{{ section.id }}" class="storefront-navigation__panel storefront-navigation__panel--pages" role="region" aria-labelledby="NavigationPagesToggle-{{ section.id }}" aria-hidden="true" inert data-navigation-panel>
          <ul class="storefront-navigation__pages-list">
            {% if section.settings.pages_menu != blank %}
              {% for link in section.settings.pages_menu.links %}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {% endfor %}
            {% else %}
            <li><a href="{{ about_us_url }}" data-navigation-first-link>{{ 'navigation.about_us' | t }}</a></li>
            <li><a href="{{ contact_url }}">{{ 'navigation.contact' | t }}</a></li>
            <li><a href="{{ faqs_url }}">{{ 'navigation.faqs' | t }}</a></li>
            <li><a href="{{ store_locations_url }}">{{ 'navigation.store_locations' | t }}</a></li>
            <li><a href="{{ recently_viewed_url }}">{{ 'navigation.recently_viewed' | t }}</a></li>
            <li><a href="{{ journal_url }}">{{ 'navigation.our_journal' | t }}</a></li>
            {% endif %}
          </ul>
        </div>
      </li>
    </ul>

    <a class="storefront-navigation__brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% if shop.brand.logo != blank %}
        {{ shop.brand.logo | image_url: width: 260 | image_tag: class: 'storefront-navigation__brand-image', loading: 'eager', alt: '' }}
      {% else %}
        <span aria-hidden="true">HELIX</span>
      {% endif %}
    </a>

    <div class="storefront-navigation__utility-actions">
      {% if localization.available_countries.size > 1 %}
        <details class="storefront-navigation__currency">
          <summary aria-label="Change country or currency">
            <span class="storefront-navigation__currency-flag" aria-hidden="true">★</span>
            <span>{{ navigation_currency_code }} {{ localization.country.currency.symbol }}</span>
            <svg aria-hidden="true" viewBox="0 0 12 8" focusable="false"><path d="m1 1 5 5 5-5" /></svg>
          </summary>
          <div class="storefront-navigation__currency-popover">
            {% form 'localization', id: navigation_localization_form_id %}
              <input type="hidden" name="return_to" value="{{ request.path }}">
              {% for country in localization.available_countries %}
                <button type="submit" name="country_code" value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} aria-current="true"{% endif %}>
                  {{ country.name | escape }} · {{ country.currency.iso_code }}
                </button>
              {% endfor %}
            {% endform %}
          </div>
        </details>
      {% else %}
        <span class="storefront-navigation__currency-static">
          <span class="storefront-navigation__currency-flag" aria-hidden="true">★</span>
          <span>{{ navigation_currency_code }} {{ localization.country.currency.symbol }}</span>
        </span>
      {% endif %}
      <span class="storefront-navigation__utility-separator" aria-hidden="true"></span>
      <a class="storefront-navigation__utility-link" href="{{ routes.search_url }}" aria-label="Search">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="10.75" cy="10.75" r="7.25" /><path d="m16.25 16.25 4.25 4.25" /></svg>
      </a>
      <a class="storefront-navigation__utility-link" href="{{ routes.account_url }}" aria-label="Account">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><circle cx="12" cy="8" r="4" /><path d="M4.5 21c.55-4.25 3.65-7 7.5-7s6.95 2.75 7.5 7" /></svg>
      </a>
      <a class="storefront-navigation__utility-link" href="{{ routes.cart_url }}" aria-label="Cart ({{ cart.item_count }})">
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false"><path d="M5 8.5h14l-1 12H6l-1-12Z" /><path d="M8.5 9V6.75a3.5 3.5 0 0 1 7 0V9" /></svg>
      </a>
    </div>
  </nav>
</header>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@700&family=Figtree:wght@400;500;700&display=swap');

  .storefront-navigation {
    --navigation-gutter: clamp(48px, 3.2vw, 60px);
    --navigation-trigger-color: #131313;
    --navigation-sticky-top: 0px;
    position: relative;
    z-index: 30;
    width: 100%;
  }

  .storefront-navigation--homepage {
    --navigation-trigger-color: #FFFFFF;
    position: absolute;
    inset: 0 0 auto;
  }

  .storefront-navigation--homepage.is-menu-open .storefront-navigation__bar {
    background: #FFFFFF;
  }

  .storefront-navigation--homepage.is-menu-open {
    --navigation-trigger-color: #131313;
  }

  .storefront-navigation--homepage.is-menu-open .storefront-navigation__collection-link,
  .storefront-navigation--homepage.is-menu-open .storefront-navigation__toggle,
  .storefront-navigation--homepage.is-menu-open .storefront-navigation__pages-toggle {
    color: #131313;
  }

  .storefront-navigation__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 32px;
    min-height: 76px;
    padding: 20px var(--navigation-gutter);
    transition: background-color 280ms ease, border-radius 280ms ease, box-shadow 280ms ease, margin 280ms ease, padding 280ms ease;
  }

  .storefront-navigation__list,
  .storefront-navigation__editorial-list,
  .storefront-navigation__child-list,
  .storefront-navigation__pages-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .storefront-navigation__list {
    grid-column: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 28px;
  }

  .storefront-navigation__brand {
    grid-column: 2;
    justify-self: center;
    color: var(--navigation-trigger-color);
    font-family: Archivo, sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .storefront-navigation__brand-image {
    display: block;
    width: auto;
    max-width: 136px;
    height: 34px;
    object-fit: contain;
  }

  .storefront-navigation__utility-actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 12px;
    color: var(--navigation-trigger-color);
  }

  .storefront-navigation__currency summary,
  .storefront-navigation__currency-static,
  .storefront-navigation__utility-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 22.4px;
    letter-spacing: 0.28px;
  }

  .storefront-navigation__currency {
    position: relative;
    color: currentColor;
  }

  .storefront-navigation__currency summary,

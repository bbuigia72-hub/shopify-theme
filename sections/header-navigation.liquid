{% javascript %}
  (() => {
    const initialiseNavigation = (root) => {
      if (root.dataset.navigationInitialised === 'true') return;

      root.dataset.navigationInitialised = 'true';

      const desktopMedia = window.matchMedia('(min-width: 750px)');
      const hoverMedia = window.matchMedia('(min-width: 750px) and (hover: hover) and (pointer: fine)');
      const mobileMedia = window.matchMedia('(max-width: 749px)');
      const mainContent = document.getElementById('MainContent');
      const mobileBar = root.querySelector('.storefront-navigation__mobile-bar');
      const mobileDrawer = root.querySelector('[data-mobile-drawer]');
      const mobileDrawerDialog = root.querySelector('[data-mobile-drawer-dialog]');
      const mobileDrawerOpen = root.querySelector('[data-mobile-drawer-open]');
      const mobileDrawerCloseButtons = [...root.querySelectorAll('[data-mobile-drawer-close]')];
      const mobileDrawerOpenButtons = [...root.querySelectorAll('[data-mobile-open-panel]')];
      const mobileDrawerBackButtons = [...root.querySelectorAll('[data-mobile-show-root]')];
      const mobileDrawerPanels = [...root.querySelectorAll('[data-mobile-panel]')];
      const items = [...root.querySelectorAll('[data-navigation-item]')].map((item) => ({
        item,
        toggle: item.querySelector('[data-navigation-toggle]'),
        panel: item.querySelector('[data-navigation-panel]'),
        collectionLink: item.querySelector('[data-navigation-collection-link]'),
        firstLink: item.querySelector('[data-navigation-panel] a[href]'),
        openTimer: null,
        closeTimer: null,
        openedByToggle: false,
        lastTrigger: null
      }));
      const hoverOpenDelay = 70;
      let activeItem = null;
      let stickyFrame = null;

      const syncStickyState = () => {
        if (!desktopMedia.matches) {
          root.classList.remove('is-scrolled', 'is-sticky');
          return;
        }

        if (root.classList.contains('is-menu-open')) return;

        const isScrolled = window.scrollY > 8;
        root.classList.toggle('is-scrolled', isScrolled);
        root.classList.toggle('is-sticky', root.classList.contains('storefront-navigation--homepage') && isScrolled);
      };

      const requestStickySync = () => {
        if (stickyFrame) return;

        stickyFrame = window.requestAnimationFrame(() => {
          stickyFrame = null;
          syncStickyState();
        });
      };

      const updateMainInteractivity = () => {
        const hasOpenMegaPanel = items.some(({ item }) => item.classList.contains('storefront-navigation__item--mega') && item.classList.contains('is-open'));
        const hasOpenMobileDrawer = root.classList.contains('is-mobile-menu-open');
        mainContent?.toggleAttribute('inert', hasOpenMegaPanel || hasOpenMobileDrawer);
        document.body.classList.toggle('storefront-navigation-menu-open', hasOpenMegaPanel);
        document.body.classList.toggle('storefront-navigation-mobile-menu-open', hasOpenMobileDrawer);
        root.classList.toggle('is-mega-menu-open', hasOpenMegaPanel);
      };

      const setToggleState = (entry, isOpen) => {
        entry.toggle.setAttribute('aria-expanded', String(isOpen));

        const label = isOpen ? entry.toggle.dataset.closeLabel : entry.toggle.dataset.openLabel;
        if (label) entry.toggle.setAttribute('aria-label', label);
      };

      const closeItem = (entry) => {
        if (!entry) return;

        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        if (entry.panel.contains(document.activeElement)) {
          (entry.lastTrigger || entry.toggle).focus();
        }
        entry.item.classList.remove('is-open');
        entry.panel.classList.remove('is-open');
        setToggleState(entry, false);
        entry.panel.setAttribute('aria-hidden', 'true');
        entry.panel.setAttribute('inert', '');
        entry.openedByToggle = false;

        if (activeItem === entry) activeItem = null;
        updateMainInteractivity();
        if (!root.querySelector('[data-navigation-item].is-open')) {
          root.classList.remove('is-menu-open');
          syncStickyState();
        }
      };

      const closeAll = (exceptEntry = null) => {
        items.forEach((entry) => {
          if (entry !== exceptEntry) closeItem(entry);
        });
      };

      const openItem = (entry) => {
        if (!desktopMedia.matches || !entry) return;

        syncStickyState();
        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        closeAll(entry);
        entry.item.classList.add('is-open');
        entry.panel.classList.add('is-open');
        setToggleState(entry, true);
        entry.panel.setAttribute('aria-hidden', 'false');
        entry.panel.removeAttribute('inert');
        root.classList.add('is-menu-open');
        activeItem = entry;
        updateMainInteractivity();
      };

      const queueClose = (entry) => {
        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        entry.closeTimer = window.setTimeout(() => {
          if (!entry.item.matches(':hover') && !entry.item.contains(document.activeElement)) closeItem(entry);
        }, 180);
      };

      const queueOpen = (entry) => {
        if (entry.item.classList.contains('is-open')) return;

        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        entry.openTimer = window.setTimeout(() => {
          if (entry.item.matches(':hover')) openItem(entry);
        }, hoverOpenDelay);
      };

      const showMobilePanel = (panelName, shouldFocus = true) => {
        const targetPanel = mobileDrawerPanels.find((panel) => panel.dataset.mobilePanel === panelName);
        if (!targetPanel) return;

        mobileDrawerPanels.forEach((panel) => {
          const isActive = panel === targetPanel;
          panel.classList.toggle('is-active', isActive);
          panel.setAttribute('aria-hidden', String(!isActive));
          panel.toggleAttribute('inert', !isActive);
        });

        mobileDrawerOpenButtons.forEach((button) => {
          button.setAttribute('aria-expanded', String(button.dataset.mobileOpenPanel === panelName));
        });

        root.classList.toggle('is-mobile-submenu-open', panelName !== 'root');

        if (shouldFocus) {
          window.requestAnimationFrame(() => {
            targetPanel.querySelector('[data-mobile-show-root], [data-mobile-panel-focus], a[href], button:not([disabled])')?.focus({ preventScroll: true });
          });
        }
      };

      const closeMobileDrawer = (shouldRestoreFocus = true) => {
        if (!mobileDrawer?.classList.contains('is-open')) return;

        root.classList.remove('is-mobile-menu-open');
        root.classList.remove('is-mobile-submenu-open');
        mobileDrawer.classList.remove('is-open');
        mobileDrawer.setAttribute('aria-hidden', 'true');
        mobileDrawer.setAttribute('inert', '');
        mobileBar?.removeAttribute('inert');
        mobileBar?.removeAttribute('aria-hidden');
        mobileDrawerOpen?.setAttribute('aria-expanded', 'false');
        showMobilePanel('root', false);
        updateMainInteractivity();

        if (shouldRestoreFocus) mobileDrawerOpen?.focus({ preventScroll: true });
      };

      const openMobileDrawer = () => {
        if (!mobileMedia.matches || !mobileDrawer || !mobileDrawerOpen) return;

        closeAll();
        showMobilePanel('root', false);
        root.classList.add('is-mobile-menu-open');
        mobileDrawer.classList.add('is-open');
        mobileDrawer.setAttribute('aria-hidden', 'false');
        mobileDrawer.removeAttribute('inert');
        mobileBar?.setAttribute('inert', '');
        mobileBar?.setAttribute('aria-hidden', 'true');
        mobileDrawerOpen.setAttribute('aria-expanded', 'true');
        updateMainInteractivity();

        window.requestAnimationFrame(() => mobileDrawerDialog?.focus({ preventScroll: true }));
      };

      const trapMobileDrawerFocus = (event) => {
        if (event.key !== 'Tab' || !root.classList.contains('is-mobile-menu-open') || !mobileDrawerDialog) return;

        const focusable = [...mobileDrawerDialog.querySelectorAll('a[href], button:not([disabled]), summary, [tabindex]:not([tabindex="-1"])')]
          .filter((element) => !element.closest('[inert]') && element.getClientRects().length > 0);

        if (!focusable.length) {
          event.preventDefault();
          mobileDrawerDialog.focus({ preventScroll: true });
          return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && (document.activeElement === first || document.activeElement === mobileDrawerDialog)) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      };

      items.forEach((entry) => {
        entry.item.addEventListener('pointerenter', () => {
          if (!hoverMedia.matches) return;
          queueOpen(entry);
        });

        entry.item.addEventListener('pointerleave', () => {
          if (!hoverMedia.matches) return;
          queueClose(entry);
        });

        entry.item.addEventListener('focusin', (event) => {
          if (desktopMedia.matches) openItem(entry);

          if (event.target === entry.collectionLink || event.target === entry.toggle) {
            entry.lastTrigger = event.target;
          }
        });

        entry.item.addEventListener('focusout', () => {
          window.requestAnimationFrame(() => {
            if (!entry.item.contains(document.activeElement)) queueClose(entry);
          });
        });

        entry.toggle.addEventListener('click', () => {
          if (!desktopMedia.matches) return;

          entry.lastTrigger = entry.toggle;

          if (entry.item.classList.contains('is-open') && entry.openedByToggle) {
            closeItem(entry);
          } else {
            entry.openedByToggle = true;
            openItem(entry);
          }
        });

        entry.item.addEventListener('keydown', (event) => {
          if (!desktopMedia.matches || event.key !== 'ArrowDown') return;
          if (event.target !== entry.toggle && event.target !== entry.collectionLink) return;

          event.preventDefault();
          entry.lastTrigger = event.target;
          openItem(entry);
          entry.firstLink?.focus();
        });
      });

      mobileDrawerOpen?.addEventListener('click', openMobileDrawer);
      mobileDrawerCloseButtons.forEach((button) => button.addEventListener('click', () => closeMobileDrawer()));
      mobileDrawerOpenButtons.forEach((button) => {
        button.addEventListener('click', () => showMobilePanel(button.dataset.mobileOpenPanel));
      });
      mobileDrawerBackButtons.forEach((button) => button.addEventListener('click', () => showMobilePanel('root')));

      document.addEventListener('pointerdown', (event) => {
        if (!root.contains(event.target)) closeAll();
      });

      document.addEventListener('keydown', (event) => {
        trapMobileDrawerFocus(event);

        if (event.key === 'Escape' && root.classList.contains('is-mobile-menu-open')) {
          event.preventDefault();
          closeMobileDrawer();
          return;
        }

        if (event.key !== 'Escape' || !activeItem) return;

        event.preventDefault();
        const entry = activeItem;
        closeItem(entry);
      });

      window.addEventListener('scroll', requestStickySync, { passive: true });

      desktopMedia.addEventListener('change', () => {
        if (!desktopMedia.matches) closeAll();
        syncStickyState();
      });

      mobileMedia.addEventListener('change', () => {
        if (!mobileMedia.matches) closeMobileDrawer(false);
      });

      syncStickyState();
    };

    const initialiseAllNavigations = () => {
      document.querySelectorAll('[data-storefront-navigation]').forEach(initialiseNavigation);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialiseAllNavigations, { once: true });
    } else {
      initialiseAllNavigations();
    }
  })();
{% endjavascript %}


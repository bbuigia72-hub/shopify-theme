{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@700&family=Figtree:wght@400;500;700&display=swap');

  .storefront-navigation {
    --navigation-gutter: clamp(48px, 3.2vw, 60px);
    --navigation-trigger-color: #131313;
    --navigation-sticky-top: 0px;
    --navigation-panel-duration: 520ms;
    --navigation-panel-fade-duration: 300ms;
    --navigation-panel-ease: cubic-bezier(0.6, 0.14, 0, 1);
    position: relative;
    z-index: 30;
    width: 100%;
  }

  .storefront-navigation--homepage {
    --navigation-trigger-color: #FFFFFF;
    position: absolute;
    inset: 0 0 auto;
  }

  .storefront-navigation--homepage.is-menu-open .storefront-navigation__bar {
    background: #FFFFFF;
  }

  .storefront-navigation--homepage.is-menu-open {
    --navigation-trigger-color: #131313;
  }

  .storefront-navigation--homepage.is-menu-open .storefront-navigation__collection-link,
  .storefront-navigation--homepage.is-menu-open .storefront-navigation__toggle,
  .storefront-navigation--homepage.is-menu-open .storefront-navigation__pages-toggle {
    color: #131313;
  }

  .storefront-navigation__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    column-gap: 32px;
    min-height: 76px;
    padding: 20px var(--navigation-gutter);
    transition: background-color 280ms ease, border-radius 280ms ease, box-shadow 280ms ease, margin 280ms ease, padding 280ms ease;
  }

  .storefront-navigation__list,
  .storefront-navigation__editorial-list,
  .storefront-navigation__child-list,
  .storefront-navigation__pages-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .storefront-navigation__list {
    grid-column: 1;
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 28px;
  }

  .storefront-navigation__brand {
    grid-column: 2;
    justify-self: center;
    color: var(--navigation-trigger-color);
    font-family: Archivo, sans-serif;
    font-size: 32px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.08em;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .storefront-navigation__brand-image {
    display: block;
    width: auto;
    max-width: 136px;
    height: 34px;
    object-fit: contain;
  }

  .storefront-navigation__utility-actions {
    grid-column: 3;
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 12px;
    color: var(--navigation-trigger-color);
  }

  .storefront-navigation__currency summary,
  .storefront-navigation__currency-static,
  .storefront-navigation__utility-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: currentColor;
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 22.4px;
    letter-spacing: 0.28px;
  }

  .storefront-navigation__currency {
    position: relative;
    color: currentColor;
  }

  .storefront-navigation__currency summary,
  .storefront-navigation__currency-static {
    gap: 8px;
    white-space: nowrap;
  }

  .storefront-navigation__currency summary {
    cursor: pointer;
    list-style: none;
  }

  .storefront-navigation__currency summary::-webkit-details-marker {
    display: none;
  }

  .storefront-navigation__currency-flag {
    display: grid;
    width: 19px;
    height: 19px;
    place-items: center;
    border-radius: 50%;
    background: #E60012;
    color: #FFE500;
    font-size: 11px;
    line-height: 1;
  }

  .storefront-navigation__currency svg {
    width: 10px;
    height: 7px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 200ms ease-in-out;
  }

  .storefront-navigation__currency[open] summary svg {
    transform: rotate(180deg);
  }

  .storefront-navigation__currency-popover {
    position: absolute;
    z-index: 3;
    top: calc(100% + 12px);
    right: 0;
    width: max-content;
    min-width: 190px;
    padding: 10px;
    border-radius: 12px;
    background: #FFFFFF;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.10);
    color: #131313;
  }

  .storefront-navigation__currency-popover form {
    display: grid;
    gap: 2px;
  }

  .storefront-navigation__currency-popover button {
    width: 100%;
    padding: 8px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #131313;
    cursor: pointer;
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 22.4px;
    text-align: left;
  }

  .storefront-navigation__currency-popover button:hover,
  .storefront-navigation__currency-popover button:focus-visible,
  .storefront-navigation__currency-popover button[aria-current="true"] {
    background: rgba(19, 19, 19, 0.06);
  }

  .storefront-navigation__currency-popover button:focus-visible {
    outline: 2px solid #131313;
    outline-offset: 2px;
  }

  .storefront-navigation__utility-separator {
    width: 1px;
    height: 20px;
    margin-inline: 4px;
    background: currentColor;
    opacity: 0.18;
  }

  .storefront-navigation__utility-link {
    width: 28px;
    height: 28px;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .storefront-navigation__utility-link svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .storefront-navigation__item {
    display: flex;
    align-items: center;
  }

  .storefront-navigation__item--mega {
    position: static;
  }

  .storefront-navigation__item--pages {
    position: relative;
  }

  .storefront-navigation__collection-link,
  .storefront-navigation__toggle,
  .storefront-navigation__pages-toggle {
    color: var(--navigation-trigger-color);
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 22.4px;
    letter-spacing: 0.28px;
    text-decoration: none;
    transition: color 220ms ease;
  }

  .storefront-navigation__collection-link,
  .storefront-navigation__toggle {
    display: inline-flex;
    align-items: center;
  }

  .storefront-navigation__toggle,
  .storefront-navigation__pages-toggle {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .storefront-navigation__toggle {
    width: 18px;
    justify-content: flex-end;
  }

  .storefront-navigation__pages-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .storefront-navigation__toggle svg,
  .storefront-navigation__pages-toggle svg {
    width: 10px;
    height: 7px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 200ms ease-in-out;
  }

  .storefront-navigation__item.is-open .storefront-navigation__toggle svg,
  .storefront-navigation__item.is-open .storefront-navigation__pages-toggle svg {
    transform: rotate(180deg);
  }

  .storefront-navigation__item.is-open .storefront-navigation__collection-link,
  .storefront-navigation__item.is-open .storefront-navigation__toggle,
  .storefront-navigation__item.is-open .storefront-navigation__pages-toggle {
    color: #131313;
  }

  .storefront-navigation__item.is-open .storefront-navigation__collection-link {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 10px;
  }

  .storefront-navigation__collection-link:hover,
  .storefront-navigation__collection-link:focus-visible,
  .storefront-navigation__toggle:hover,
  .storefront-navigation__toggle:focus-visible,
  .storefront-navigation__pages-toggle:hover,
  .storefront-navigation__pages-toggle:focus-visible,
  .storefront-navigation__brand:hover,
  .storefront-navigation__brand:focus-visible,
  .storefront-navigation__currency summary:hover,
  .storefront-navigation__currency summary:focus-visible,

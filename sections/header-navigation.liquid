  .storefront-navigation__panel {
    position: absolute;
    z-index: 1;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translate3d(0, -8px, 0);
    transform-origin: top center;
    will-change: opacity, transform;
    transition: opacity var(--navigation-panel-fade-duration) var(--navigation-panel-ease), transform var(--navigation-panel-duration) var(--navigation-panel-ease), visibility 0s linear var(--navigation-panel-duration);
  }

  .storefront-navigation__panel.is-open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translate3d(0, 0, 0);
    transition: opacity var(--navigation-panel-fade-duration) var(--navigation-panel-ease), transform var(--navigation-panel-duration) var(--navigation-panel-ease), visibility 0s linear 0s;
    transition-delay: 0s, 0s, 0s;
  }

  .storefront-navigation__panel--mega {
    top: 100%;
    right: 0;
    left: 0;
    width: 100%;
    height: 0;
    max-height: 50vh;
    overflow: hidden;
    clip-path: none;
    transform: none;
    will-change: height, opacity;
    box-shadow: 0 18px 30px rgba(0, 0, 0, 0.10);
    transition: height var(--navigation-panel-duration) var(--navigation-panel-ease), opacity var(--navigation-panel-fade-duration) var(--navigation-panel-ease), visibility 0s linear var(--navigation-panel-duration);
  }

  .storefront-navigation__panel--mega.is-open {
    height: 50vh;
    transform: none;
    transition: height var(--navigation-panel-duration) var(--navigation-panel-ease), opacity var(--navigation-panel-fade-duration) var(--navigation-panel-ease), visibility 0s linear 0s;
    transition-delay: 0s, 0s, 0s;
  }

  .storefront-navigation__panel--mega.is-open::before {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    left: 0;
    height: 50vh;
    content: '';
  }

  .storefront-navigation__mega-surface {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 50vh;
    max-height: 100%;
    min-height: 0;
    overflow-x: hidden;
    overflow-y: auto;
    padding: 38px var(--navigation-gutter) 52px;
    background: #FFFFFF;
    box-shadow: none;
    box-sizing: border-box;
  }

  #MainContent {
    transition: filter 320ms ease, opacity 320ms ease;
  }

  body.storefront-navigation-menu-open #MainContent {
    filter: blur(1.5px) brightness(0.72) saturate(0.7);
    opacity: 0.65;
    pointer-events: none;
  }

  .storefront-navigation__mega-grid {
    display: grid;
    align-items: start;
  }

  .storefront-navigation__mega-grid--women {
    width: 100%;
    grid-template-columns: repeat(3, 200px) minmax(0, 1fr);
    column-gap: 40px;
  }

  .storefront-navigation__mega-grid--men {
    width: 100%;
    grid-template-columns: 680px minmax(0, 1fr);
    column-gap: 40px;
  }

  .storefront-navigation__menu-columns {
    display: grid;
    min-width: 0;
    grid-template-columns: repeat(3, 200px);
    column-gap: 40px;
  }

  .storefront-navigation__menu-reveal {
    opacity: 0;
    transform: translate3d(0, 15px, 0);
    will-change: opacity, transform;
    transition: opacity 300ms ease, transform 300ms ease;
  }

  .storefront-navigation__panel--mega.is-open .storefront-navigation__menu-reveal {
    animation: storefront-navigation-mega-item-in 520ms ease var(--menu-reveal-delay, 180ms) both;
  }

  @keyframes storefront-navigation-mega-item-in {
    from {
      opacity: 0;
      transform: translate3d(0, 15px, 0);
    }

    to {
      opacity: 1;
      transform: translateZ(0);
    }
  }

  .storefront-navigation__editorial-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .storefront-navigation__editorial-list a {
    color: #131313;
    font-family: Archivo, sans-serif;
    font-size: 18px;
    font-weight: 700;

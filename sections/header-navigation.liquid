{% javascript %}
  (() => {
    const initialiseNavigation = (root) => {
      if (root.dataset.navigationInitialised === 'true') return;

      root.dataset.navigationInitialised = 'true';

      const desktopMedia = window.matchMedia('(min-width: 750px)');
      const hoverMedia = window.matchMedia('(min-width: 750px) and (hover: hover) and (pointer: fine)');
      const mainContent = document.getElementById('MainContent');
      const items = [...root.querySelectorAll('[data-navigation-item]')].map((item) => ({
        item,
        toggle: item.querySelector('[data-navigation-toggle]'),
        panel: item.querySelector('[data-navigation-panel]'),
        collectionLink: item.querySelector('[data-navigation-collection-link]'),
        firstLink: item.querySelector('[data-navigation-panel] a[href]'),
        openTimer: null,
        closeTimer: null,
        openedByToggle: false,
        lastTrigger: null
      }));
      const hoverOpenDelay = 0;
      let activeItem = null;
      let stickyFrame = null;

      const syncStickyState = () => {
        if (!desktopMedia.matches) {
          root.classList.remove('is-scrolled', 'is-sticky');
          return;
        }

        if (root.classList.contains('is-menu-open')) return;

        const isScrolled = window.scrollY > 8;
        root.classList.toggle('is-scrolled', isScrolled);
        root.classList.toggle('is-sticky', root.classList.contains('storefront-navigation--homepage') && isScrolled);
      };

      const requestStickySync = () => {
        if (stickyFrame) return;

        stickyFrame = window.requestAnimationFrame(() => {
          stickyFrame = null;
          syncStickyState();
        });
      };

      const updateMainInteractivity = () => {
        const hasOpenMegaPanel = items.some(({ item }) => item.classList.contains('storefront-navigation__item--mega') && item.classList.contains('is-open'));
        mainContent?.toggleAttribute('inert', hasOpenMegaPanel);
        document.body.classList.toggle('storefront-navigation-menu-open', hasOpenMegaPanel);
        root.classList.toggle('is-mega-menu-open', hasOpenMegaPanel);
      };

      const setToggleState = (entry, isOpen) => {
        entry.toggle.setAttribute('aria-expanded', String(isOpen));

        const label = isOpen ? entry.toggle.dataset.closeLabel : entry.toggle.dataset.openLabel;
        if (label) entry.toggle.setAttribute('aria-label', label);
      };

      const closeItem = (entry) => {
        if (!entry) return;

        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        if (entry.panel.contains(document.activeElement)) {
          (entry.lastTrigger || entry.toggle).focus();
        }
        entry.item.classList.remove('is-open');
        entry.panel.classList.remove('is-open');
        setToggleState(entry, false);
        entry.panel.setAttribute('aria-hidden', 'true');
        entry.panel.setAttribute('inert', '');
        entry.openedByToggle = false;

        if (activeItem === entry) activeItem = null;
        updateMainInteractivity();
        if (!root.querySelector('[data-navigation-item].is-open')) {
          root.classList.remove('is-menu-open');
          syncStickyState();
        }
      };

      const closeAll = (exceptEntry = null) => {
        items.forEach((entry) => {
          if (entry !== exceptEntry) closeItem(entry);
        });
      };

      const openItem = (entry) => {
        if (!desktopMedia.matches || !entry) return;

        syncStickyState();
        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        closeAll(entry);
        entry.item.classList.add('is-open');
        entry.panel.classList.add('is-open');
        setToggleState(entry, true);
        entry.panel.setAttribute('aria-hidden', 'false');
        entry.panel.removeAttribute('inert');
        root.classList.add('is-menu-open');
        activeItem = entry;
        updateMainInteractivity();
      };

      const queueClose = (entry) => {
        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        entry.closeTimer = window.setTimeout(() => {
          if (!entry.item.matches(':hover') && !entry.item.contains(document.activeElement)) closeItem(entry);
        }, 180);
      };

      const queueOpen = (entry) => {
        if (entry.item.classList.contains('is-open')) return;

        window.clearTimeout(entry.openTimer);
        window.clearTimeout(entry.closeTimer);
        entry.openTimer = window.setTimeout(() => {
          if (entry.item.matches(':hover')) openItem(entry);
        }, hoverOpenDelay);
      };

      items.forEach((entry) => {
        entry.item.addEventListener('pointerenter', () => {
          if (!hoverMedia.matches) return;
          queueOpen(entry);
        });

        entry.item.addEventListener('pointerleave', () => {
          if (!hoverMedia.matches) return;
          queueClose(entry);
        });

        entry.item.addEventListener('focusin', (event) => {
          if (desktopMedia.matches) openItem(entry);

          if (event.target === entry.collectionLink || event.target === entry.toggle) {
            entry.lastTrigger = event.target;
          }
        });

        entry.item.addEventListener('focusout', () => {
          window.requestAnimationFrame(() => {
            if (!entry.item.contains(document.activeElement)) queueClose(entry);
          });
        });

        entry.toggle.addEventListener('click', () => {
          if (!desktopMedia.matches) return;

          entry.lastTrigger = entry.toggle;

          if (entry.item.classList.contains('is-open') && entry.openedByToggle) {
            closeItem(entry);
          } else {
            entry.openedByToggle = true;
            openItem(entry);
          }
        });

        entry.item.addEventListener('keydown', (event) => {
          if (!desktopMedia.matches || event.key !== 'ArrowDown') return;
          if (event.target !== entry.toggle && event.target !== entry.collectionLink) return;

          event.preventDefault();
          entry.lastTrigger = event.target;
          openItem(entry);
          entry.firstLink?.focus();
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (!root.contains(event.target)) closeAll();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !activeItem) return;

        event.preventDefault();
        const entry = activeItem;
        closeItem(entry);
      });

      window.addEventListener('scroll', requestStickySync, { passive: true });

      desktopMedia.addEventListener('change', () => {
        if (!desktopMedia.matches) closeAll();
        syncStickyState();
      });

      syncStickyState();
    };

    const initialiseAllNavigations = () => {
      document.querySelectorAll('[data-storefront-navigation]').forEach(initialiseNavigation);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialiseAllNavigations, { once: true });
    } else {
      initialiseAllNavigations();
    }
  })();
{% endjavascript %}


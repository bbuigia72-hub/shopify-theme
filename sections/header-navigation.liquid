  @media (max-width: 1240px) {
    .storefront-navigation__mega-grid--women {
      width: min(100%, 680px);
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 36px;
    }

    .storefront-navigation__mega-grid--men {
      width: min(100%, 680px);
      grid-template-columns: minmax(0, 1fr);
      row-gap: 36px;
    }

    .storefront-navigation__menu-columns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .storefront-navigation__promo-area,
    .storefront-navigation__men-deals {
      width: 100%;
      padding-left: 0;
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 750px) {
    .storefront-navigation {
      position: sticky;
      top: var(--navigation-sticky-top);
      z-index: 50;
    }

    .storefront-navigation--homepage {
      position: absolute;
      inset: 0 0 auto;
    }

    .storefront-navigation--homepage.is-sticky {
      position: fixed;
      top: var(--navigation-sticky-top);
      right: 0;
      left: 0;
    }

    .storefront-navigation.is-scrolled .storefront-navigation__bar {
      margin-inline: var(--navigation-gutter);
      padding-inline: clamp(24px, 2vw, 36px);
      border-radius: 20px;
      background: #FFFFFF;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.10);
    }

    .storefront-navigation.is-scrolled {
      --navigation-sticky-top: 20px;
      --navigation-floating-inset: var(--navigation-gutter);
      --navigation-floating-panel-padding: clamp(24px, 2vw, 36px);
    }

    .storefront-navigation.is-scrolled .storefront-navigation__panel--mega {
      right: var(--navigation-floating-inset);
      left: var(--navigation-floating-inset);
      width: auto;
    }

    .storefront-navigation.is-scrolled .storefront-navigation__mega-surface {
      padding-inline: var(--navigation-floating-panel-padding);
    }

    .storefront-navigation.is-scrolled.is-mega-menu-open .storefront-navigation__bar {
      border-radius: 20px 20px 0 0;
      box-shadow: none;
    }

    .storefront-navigation.is-scrolled.is-mega-menu-open .storefront-navigation__panel--mega.is-open .storefront-navigation__mega-surface {
      border-radius: 0 0 20px 20px;
    }

    .storefront-navigation--homepage.is-scrolled {
      --navigation-trigger-color: #131313;
    }
  }

  @media (min-width: 750px) and (max-width: 899px) {

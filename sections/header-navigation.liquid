  </nav>
</header>

{% stylesheet %}
  @import url('https://fonts.googleapis.com/css2?family=Archivo:wght@700&family=Figtree:wght@400;500&display=swap');

  .storefront-navigation {
    --navigation-gutter: clamp(4%, calc((100vw - 1650px) / 2), 8%);
    --navigation-trigger-color: #131313;
    position: relative;
    z-index: 30;
    width: 100%;
  }

  .storefront-navigation--homepage {
    --navigation-trigger-color: #FFFFFF;
    position: absolute;
    inset: 0 0 auto;
  }

  .storefront-navigation__bar {
    min-height: 76px;
    padding: 20px var(--navigation-gutter);
  }

  .storefront-navigation__list,
  .storefront-navigation__editorial-list,
  .storefront-navigation__child-list,
  .storefront-navigation__pages-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .storefront-navigation__list {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .storefront-navigation__item {
    display: flex;
    align-items: center;
  }

  .storefront-navigation__item--mega {
    position: static;
  }

  .storefront-navigation__item--pages {
    position: relative;
  }

  .storefront-navigation__collection-link,
  .storefront-navigation__toggle,
  .storefront-navigation__pages-toggle {
    color: var(--navigation-trigger-color);
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 22.4px;
    letter-spacing: 0.28px;
    text-decoration: none;
  }

  .storefront-navigation__collection-link,
  .storefront-navigation__toggle {
    display: inline-flex;
    align-items: center;
  }

  .storefront-navigation__toggle,
  .storefront-navigation__pages-toggle {
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .storefront-navigation__toggle {
    width: 18px;
    justify-content: flex-end;
  }

  .storefront-navigation__pages-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .storefront-navigation__toggle svg,
  .storefront-navigation__pages-toggle svg {
    width: 10px;
    height: 7px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    transition: transform 200ms ease-in-out;
  }

  .storefront-navigation__item.is-open .storefront-navigation__toggle svg,
  .storefront-navigation__item.is-open .storefront-navigation__pages-toggle svg {
    transform: rotate(180deg);
  }

  .storefront-navigation__collection-link:hover,
  .storefront-navigation__collection-link:focus-visible,
  .storefront-navigation__toggle:hover,
  .storefront-navigation__toggle:focus-visible,
  .storefront-navigation__pages-toggle:hover,
  .storefront-navigation__pages-toggle:focus-visible {
    color: #131313;
  }

  .storefront-navigation__collection-link:focus-visible,
  .storefront-navigation__toggle:focus-visible,
  .storefront-navigation__pages-toggle:focus-visible,
  .storefront-navigation__editorial-list a:focus-visible,
  .storefront-navigation__child-link:focus-visible,
  .storefront-navigation__promo-card:focus-visible,
  .storefront-navigation__pages-list a:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .storefront-navigation__panel {
    position: absolute;
    z-index: 1;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease, visibility 0s linear 180ms;
  }

  .storefront-navigation__panel.is-open {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transition-delay: 0s;
  }

  .storefront-navigation__panel--mega {
    top: 100%;
    right: 0;
    left: 0;
    width: 100%;
  }

  .storefront-navigation__mega-surface {
    width: 100%;
    padding: 28px var(--navigation-gutter) 38px;
    background: transparent;
    box-shadow: none;
  }

  .storefront-navigation__mega-grid {
    display: grid;
    align-items: start;
    gap: 32px;
  }

  .storefront-navigation__mega-grid--women {
    grid-template-columns: repeat(3, minmax(0, 0.8fr)) repeat(2, minmax(140px, 1fr));
  }

  .storefront-navigation__mega-grid--men {
    max-width: 780px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .storefront-navigation__menu-reveal {
    opacity: 0;
    transform: translateY(15px);
    transition: opacity 200ms ease, transform 200ms ease;
  }

  .storefront-navigation__panel--mega.is-open .storefront-navigation__menu-reveal {
    opacity: 1;
    transform: translateY(0);
    transition-duration: 400ms;
    transition-delay: var(--menu-reveal-delay, 150ms);
  }

  .storefront-navigation__editorial-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .storefront-navigation__editorial-list a {
    color: #131313;
    font-family: Archivo, sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 25.6px;
    text-decoration: none;
  }

  .storefront-navigation__group-label {
    margin: 0 0 25.6px;
    color: #131313;
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 500;
    line-height: 22.4px;
    letter-spacing: 0.28px;
  }

  .storefront-navigation__child-list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .storefront-navigation__child-link {
    position: relative;
    display: inline-flex;
    color: #FFFFFF;
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 22.4px;
    letter-spacing: normal;
    text-decoration: none;
  }

  .storefront-navigation__child-link::after {
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    content: '';
    transition: width 200ms ease-in-out;
  }

  .storefront-navigation__child-link:hover,
  .storefront-navigation__child-link:focus-visible {
    color: #131313;
  }

  .storefront-navigation__child-link:hover::after,
  .storefront-navigation__child-link:focus-visible::after {
    width: 100%;
  }

  .storefront-navigation__promo-card {
    position: relative;
    display: flex;
    min-height: 230px;
    overflow: hidden;
    color: #131313;
    text-decoration: none;
    background: #EAE9E4;
  }

  .storefront-navigation__promo-image,
  .storefront-navigation__promo-slot {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .storefront-navigation__promo-image {
    object-fit: cover;
  }

  .storefront-navigation__promo-slot {
    background: linear-gradient(135deg, #F4F3EF 0%, #D9D7D0 100%);
  }

  .storefront-navigation__promo-copy {
    position: relative;
    z-index: 1;
    align-self: flex-end;
    margin: 16px;
    padding: 8px 10px;
    background: #FFFFFF;
    color: #131313;
    font-family: Archivo, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 22.4px;
  }

  .storefront-navigation__panel--pages {
    top: calc(100% - 2px);
    left: 0;
    min-width: 220px;
    padding: 18px 20px;
    border-radius: 16px;
    background: #FFFFFF;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.10);
  }

  .storefront-navigation__pages-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .storefront-navigation__pages-list a {
    color: #131313;
    font-family: Figtree, sans-serif;
    font-size: 14px;
    font-weight: 400;
    line-height: 22.4px;
    text-decoration: none;
  }

  .storefront-navigation__pages-list a:hover,
  .storefront-navigation__pages-list a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 1100px) {
    .storefront-navigation__mega-grid {
      gap: 22px;
    }

    .storefront-navigation__mega-grid--women {
      grid-template-columns: repeat(3, minmax(0, 0.75fr)) repeat(2, minmax(112px, 0.9fr));
    }

    .storefront-navigation__promo-card {
      min-height: 190px;
    }
  }

  @media (max-width: 749px) {
    .storefront-navigation {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .storefront-navigation *,
    .storefront-navigation *::before,
    .storefront-navigation *::after {
      transition-duration: 0ms !important;
    }

    .storefront-navigation__menu-reveal {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const initialiseNavigation = (root) => {
      if (root.dataset.navigationInitialised === 'true') return;

      root.dataset.navigationInitialised = 'true';

      const desktopMedia = window.matchMedia('(min-width: 750px)');
      const hoverMedia = window.matchMedia('(min-width: 750px) and (hover: hover) and (pointer: fine)');
      const items = [...root.querySelectorAll('[data-navigation-item]')].map((item) => ({
        item,
        toggle: item.querySelector('[data-navigation-toggle]'),
        panel: item.querySelector('[data-navigation-panel]'),
        collectionLink: item.querySelector('[data-navigation-collection-link]'),
        firstLink: item.querySelector('[data-navigation-first-link]'),
        closeTimer: null,
        openedByToggle: false
      }));
      let activeItem = null;

      const closeItem = (entry) => {
        if (!entry) return;

        window.clearTimeout(entry.closeTimer);
        entry.item.classList.remove('is-open');
        entry.toggle.setAttribute('aria-expanded', 'false');
        entry.panel.setAttribute('aria-hidden', 'true');
        entry.panel.setAttribute('inert', '');
        entry.openedByToggle = false;

        if (activeItem === entry) activeItem = null;
      };

      const closeAll = (exceptEntry = null) => {
        items.forEach((entry) => {
          if (entry !== exceptEntry) closeItem(entry);
        });
      };

      const openItem = (entry) => {
        if (!desktopMedia.matches || !entry) return;

        window.clearTimeout(entry.closeTimer);
        closeAll(entry);
        entry.item.classList.add('is-open');
        entry.toggle.setAttribute('aria-expanded', 'true');
        entry.panel.setAttribute('aria-hidden', 'false');
        entry.panel.removeAttribute('inert');
        activeItem = entry;
      };

      const queueClose = (entry) => {
        window.clearTimeout(entry.closeTimer);
        entry.closeTimer = window.setTimeout(() => {
          if (!entry.item.matches(':hover') && !entry.item.contains(document.activeElement)) closeItem(entry);
        }, 140);
      };

      items.forEach((entry) => {
        entry.item.addEventListener('pointerenter', () => {
          if (!hoverMedia.matches) return;
          openItem(entry);
        });

        entry.item.addEventListener('pointerleave', () => {
          if (!hoverMedia.matches) return;
          queueClose(entry);
        });

        entry.item.addEventListener('focusin', () => {
          if (desktopMedia.matches) openItem(entry);
        });

        entry.item.addEventListener('focusout', () => {
          window.requestAnimationFrame(() => {
            if (!entry.item.contains(document.activeElement)) queueClose(entry);
          });
        });

        entry.toggle.addEventListener('click', () => {
          if (!desktopMedia.matches) return;

          if (entry.item.classList.contains('is-open') && entry.openedByToggle) {
            closeItem(entry);
          } else {
            entry.openedByToggle = true;
            openItem(entry);
          }
        });

        entry.item.addEventListener('keydown', (event) => {
          if (!desktopMedia.matches || event.key !== 'ArrowDown') return;
          if (event.target !== entry.toggle && event.target !== entry.collectionLink) return;

          event.preventDefault();
          openItem(entry);
          entry.firstLink?.focus();
        });
      });

      document.addEventListener('pointerdown', (event) => {
        if (!root.contains(event.target)) closeAll();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape' || !activeItem) return;

        event.preventDefault();
        const entry = activeItem;
        closeItem(entry);
        entry.toggle.focus();
      });

      desktopMedia.addEventListener('change', () => {
        if (!desktopMedia.matches) closeAll();
      });
    };

    const initialiseAllNavigations = () => {
      document.querySelectorAll('[data-storefront-navigation]').forEach(initialiseNavigation);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initialiseAllNavigations, { once: true });
    } else {
      initialiseAllNavigations();
    }
  })();
{% endjavascript %}


  .storefront-navigation__panel--pages {
    top: calc(100% - 2px);
    left: 0;
    min-width: 220px;
    max-height: 0;
    overflow: hidden;
    padding: 0 20px;
    border-radius: 16px;
    background: #FFFFFF;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.10);
    will-change: max-height, opacity, transform;
    transition: max-height 300ms cubic-bezier(0.6, 0.14, 0, 1), padding 300ms cubic-bezier(0.6, 0.14, 0, 1), opacity 200ms cubic-bezier(0.6, 0.14, 0, 1), transform 300ms cubic-bezier(0.6, 0.14, 0, 1), visibility 0s linear 300ms;
  }

  .storefront-navigation__panel--pages.is-open {
    max-height: 360px;
    padding: 18px 20px;
    animation: none;
    transition: max-height 300ms cubic-bezier(0.6, 0.14, 0, 1), padding 300ms cubic-bezier(0.6, 0.14, 0, 1), opacity 200ms cubic-bezier(0.6, 0.14, 0, 1), transform 300ms cubic-bezier(0.6, 0.14, 0, 1), visibility 0s linear 0s;
  }

  .storefront-navigation__pages-list {
    display: flex;
    flex-direction: column;
    gap: 12px;

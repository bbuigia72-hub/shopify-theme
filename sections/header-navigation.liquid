            {% if section.settings.facebook_url != blank %}<a href="{{ section.settings.facebook_url }}" aria-label="Facebook">{% else %}<span aria-hidden="true">{% endif %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8h2V5.1c-.35-.05-1.55-.1-2.95-.1-2.9 0-4.9 1.77-4.9 5v2.8H5v3.25h3.15V24H12v-7.95h3.18l.5-3.25H12V10.1c0-.94.25-2.1 2-2.1Z" /></svg>
            {% if section.settings.facebook_url != blank %}</a>{% else %}</span>{% endif %}
            {% if section.settings.instagram_url != blank %}<a href="{{ section.settings.instagram_url }}" aria-label="Instagram">{% else %}<span aria-hidden="true">{% endif %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" /></svg>
            {% if section.settings.instagram_url != blank %}</a>{% else %}</span>{% endif %}
            {% if section.settings.youtube_url != blank %}<a href="{{ section.settings.youtube_url }}" aria-label="YouTube">{% else %}<span aria-hidden="true">{% endif %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.6 7.2a2.9 2.9 0 0 0-2-2C17.85 4.7 12 4.7 12 4.7s-5.85 0-7.6.5a2.9 2.9 0 0 0-2 2A30 30 0 0 0 2 12a30 30 0 0 0 .4 4.8 2.9 2.9 0 0 0 2 2c1.75.5 7.6.5 7.6.5s5.85 0 7.6-.5a2.9 2.9 0 0 0 2-2A30 30 0 0 0 22 12a30 30 0 0 0-.4-4.8Z" /><path d="m10 15.5 5-3.5-5-3.5v7Z" fill="#F3F4F5" /></svg>
            {% if section.settings.youtube_url != blank %}</a>{% else %}</span>{% endif %}
            {% if section.settings.tiktok_url != blank %}<a href="{{ section.settings.tiktok_url }}" aria-label="TikTok">{% else %}<span aria-hidden="true">{% endif %}
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 3v11.15a4.45 4.45 0 1 1-3.8-4.4v2.45a2.1 2.1 0 1 0 1.45 2V3h2.35c.35 2.35 1.65 3.75 4 4.15v2.3c-1.55-.12-2.9-.67-4-1.6Z" /></svg>
            {% if section.settings.tiktok_url != blank %}</a>{% else %}</span>{% endif %}
          </div>
        </div>
      </div>


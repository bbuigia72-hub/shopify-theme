  .storefront-navigation__promo-media {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1.51;
    border-radius: 20px;
    background: #EAE9E4;
  }

  .storefront-navigation__promo-image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;

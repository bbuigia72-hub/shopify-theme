<section class="hero-slideshow" data-slideshow data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.change_slides_speed | times: 1000 }}" style="--overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};">
  <div class="hero-nav">
    <div class="hero-nav__links">
      <a href="{{ routes.all_products_collection_url }}">Shop <span aria-hidden="true">⌄</span></a>
      <a href="{{ routes.collections_url }}">Collections <span aria-hidden="true">⌄</span></a>
      <a href="{{ routes.root_url }}#about">Pages <span aria-hidden="true">⌄</span></a>
      <a href="{{ routes.root_url }}#features">Features <span aria-hidden="true">⌄</span></a>
    </div>
    <a class="hero-nav__brand" href="{{ routes.root_url }}">{{ shop.name | default: 'little PEBBLE' }}</a>
    <div class="hero-nav__actions">
      <span class="hero-nav__search">What are you looking for?</span>
      <a href="{{ routes.search_url }}" aria-label="Search">⌕</a>
      <a href="{{ routes.account_login_url }}" aria-label="Account">♙</a>
      <a href="{{ routes.cart_url }}" aria-label="Cart">♧</a>
    </div>
  </div>

  <div class="hero-slideshow__slides">
    {% for block in section.blocks %}
      <article class="hero-slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {{ block.settings.image | image_url: width: 2400 | image_tag: class: 'hero-slide__image', loading: 'lazy', widths: '900, 1200, 1600, 2000, 2400' }}
        {% else %}
          <div class="hero-slide__image hero-slide__image--fallback" role="img" aria-label="{{ block.settings.heading | escape }}"></div>
        {% endif %}
        {% if block.settings.mobile_image != blank %}
          {{ block.settings.mobile_image | image_url: width: 1600 | image_tag: class: 'hero-slide__image hero-slide__image--mobile', loading: 'lazy', widths: '600, 900, 1200, 1600' }}
        {% endif %}
        <div class="hero-slide__shade"></div>
        <div class="hero-slide__content">
          {% if block.settings.eyebrow != blank %}<p class="hero-slide__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
          {% if block.settings.heading != blank %}<h1>{{ block.settings.heading }}</h1>{% endif %}
          {% if block.settings.button_label != blank %}<a class="hero-slide__button" href="{{ block.settings.button_link | default: routes.all_products_collection_url }}">{{ block.settings.button_label }} <span aria-hidden="true">→</span></a>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>

  {% if section.blocks.size > 1 %}
    <div class="hero-slideshow__controls">
      <div class="hero-slideshow__counter"><span data-current>01</span><span aria-hidden="true">/</span><span>{{ section.blocks.size | prepend: '0' }}</span></div>
      <div class="hero-slideshow__dots">{% for block in section.blocks %}<button type="button" data-dot="{{ forloop.index0 }}" aria-label="Go to slide {{ forloop.index }}"{% if forloop.first %} aria-current="true"{% endif %}></button>{% endfor %}</div>
      <button type="button" data-prev aria-label="Previous slide">←</button>
      <button type="button" data-next aria-label="Next slide">→</button>
    </div>
  {% endif %}
</section>

{% schema %}
{"name":"Pebble-style slideshow","tag":"section","class":"section-slideshow","settings":[{"type":"checkbox","id":"autoplay","label":"Auto-rotate slides","default":true},{"type":"range","id":"change_slides_speed","label":"Change slides every","min":3,"max":10,"step":1,"unit":"s","default":5},{"type":"range","id":"overlay_opacity","label":"Image overlay","min":0,"max":70,"step":5,"unit":"%","default":8},{"type":"select","id":"content_position","label":"Content position","options":[{"value":"middle-left","label":"Middle left"},{"value":"middle-center","label":"Middle center"}],"default":"middle-left"}],"blocks":[{"type":"slide","name":"Image slide","settings":[{"type":"image_picker","id":"image","label":"Desktop image"},{"type":"image_picker","id":"mobile_image","label":"Mobile image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"NEW CAMPAIGN"},{"type":"text","id":"heading","label":"Heading","default":"Softness in Comfort"},{"type":"text","id":"button_label","label":"Button label","default":"Shop Collection"},{"type":"url","id":"button_link","label":"Button link"}]}],"presets":[{"name":"Pebble-style slideshow","blocks":[{"type":"slide"},{"type":"slide"}]}]}
{% endschema %}

          {% endif %}
          <ul 
            class="beae-swatch-color__list beae-swatch-color__item" 
            data-total-variant="{{ option.values.size }}"
            data-max-desktop="{{ beae_swatches_max_items }}"
            data-max-mobile="{{ beae_swatches_max_items_mobile }}">
            {%- assign index = option.position | prepend: 'option' -%}
            {% assign value_key_selected = variant_selected[index] %}
            <input
              class="beae-swatch-color-input"
              type="hidden"
              name="beae_option_{{option_index}}"
              value="{{ value_key_selected }}"
              data-option-name="option_{{ option_index }}"
              data-option-position="{{ option.position }}"
            >
            {% assign option_values = option.values %}
            {% assign beae_count_variant = 0 %}

            {% for value in option_values %}
              {% if beae_count_variant >= beae_swatches_max_items %}
                {% break %}
              {% endif %}
              {% assign value_key = value %}
              {% assign matched_variant = nil %}
              {% for v in product.variants %}
                {% if v.options[option_index] == value %}
                  {% assign matched_variant = v %}
                  {% break %}
                {% endif %}
              {% endfor %}
              {% if beae_swatch_type contains 'color' %}
                <li
                  class="beae-swatch-item beae-swatch-color-item
                  {% if store_colors and store_colors.value[value_key] == blank %} beae-product-colors--no-color{% endif %}
                  {% if variant_selected.options[option_index] == value %} beae-swatch-item-active{% endif %}
                  {% unless product.available %} variant-item-disable{% endunless %}"

                  data-value="{{ value }}"
                  data-option-position="{{ option.position }}"
                  data-variant-id="{{ matched_variant.id }}"

                  {% if source == 'beae' %}
                    {% if store_colors and store_colors.value[value_key] != blank %}
                      style="background-color: {{ store_colors.value[value_key] }}"
                    {% else %}
                      data-beae-tooltip="Please set the color in settings"
                    {% endif %}
                  {% else %}
                    {% assign swatch_value = nil %}
                    {% for opt_value in option.values %}
                      {% if opt_value == value %}
                        {% assign swatch_value = opt_value %}
                        {% break %}
                      {% endif %}
                    {% endfor %}

                    {% if swatch_value and swatch_value.swatch %}
                      {% if swatch_value.swatch.image %}
                        style="
                          --beae-swatch-background: url({{ swatch_value.swatch.image | image_url: width: 50 }});
                          {% if swatch_value.swatch.image.presentation.focal_point %}
                            --beae-swatch-focal-point: {{ swatch_value.swatch.image.presentation.focal_point }};
                          {% endif %}
                        "
                      {% elsif swatch_value.swatch.color %}
                        style="--beae-swatch-background: rgb({{ swatch_value.swatch.color.rgb }});"
                      {% endif %}
                    {% endif %}
                  {% endif %}
                ></li>
              {% endif %}
              {% if beae_swatch_type contains 'button' %}
                <li
                  class="beae-swatch-item beae-swatch-button-item
                  {% if variant_selected.options[option_index] == value %} beae-swatch-item-active{% endif %}
                  {% unless product.available %} variant-item-disable{% endunless %}"

                  data-value="{{ value }}"
                  data-option-position="{{ option.position }}"
                  data-variant-id="{{ matched_variant.id }}"
                >
                  {{ value }}
                </li>
              {% endif %}
              {% if beae_swatch_type contains 'image' %}
                <li
                  class="beae-swatch-item beae-watch-image-item beae-product-swatch-item-image
                  {% if variant_selected.options[option_index] == value %} beae-swatch-item-active{% endif %}
                  {% unless product.available %} variant-item-disable{% endunless %}"

                  data-value="{{ value }}"
                  data-option-position="{{ option.position }}"
                  data-variant-id="{{ matched_variant.id }}"
                >
                  <img
                    src="{{ matched_variant.image | img_url: crop: 'center' }}"
                    alt="{{ value }}"
                    height="{{ matched_variant.image.height | default: 100 }}"
                    width="{{ matched_variant.image.width | default: 100 }}"
                    loading="lazy"
                  />
                </li>
              {% endif %}

              {% assign beae_count_variant = beae_count_variant | plus: 1 %}
            {% endfor %}
            {% assign max_items = beae_swatches_max_items %}

            {% if beae_swatches_max_items_mobile != blank %}
              {% assign max_items = beae_swatches_max_items_mobile %}
            {% endif %}

            <span class="beae-swatch-more">
              {% if option.values.size > max_items %}
                +{{ option.values.size | minus: max_items }}
              {% endif %}
            </span>
          </ul>
        {% endif %}
      {% endfor %}
      <select name="variant_id" data-product-id="{{ product.id }}" style="display:none;" id="beae-swatch-color-selector-{{ product.id }}">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}">{{ variant.title }}</option>
        {% endfor %}
      </select>
    {% endunless %}
